---
import SideBar from "./SideBar.astro";
import Footer from "./Footer.astro";

const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="bg-gradient-to-br from-orange-300 to-violet-300 min-h-screen">
    <div class="bg-red-500 text-white p-3">For musical improv games, check out <a class="underline" href="https://musicalimprov.org/">MusicalImprov.org</a>! <br />We are no longer maintaining this site. We copied all of this content over there.</div>
    <div class="lg:flex">
      <SideBar />
      <slot />
      <Footer />
    </div>
  </body>
</html>
